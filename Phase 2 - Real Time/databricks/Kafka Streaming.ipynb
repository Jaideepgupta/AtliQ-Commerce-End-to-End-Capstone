import json
from pathlib import Path

src = Path("/mnt/data/Pasted text(20260921-105434).txt")
data = json.loads(src.read_text(encoding="utf-8"))

for cell in data.get("cells", []):
    if cell.get("cell_type") == "code":
        source = cell.get("source", [])
        joined = "".join(source)
        if all(x in joined for x in ["KAFKA_BOOTSTRAP =", "KAFKA_API_KEY =", "KAFKA_API_SECRET ="]):
            updated = []
            for line in source:
                if line.startswith("KAFKA_BOOTSTRAP ="):
                    updated.append('KAFKA_BOOTSTRAP = "<your-bootstrap-server>"\n')
                elif line.startswith("KAFKA_API_KEY ="):
                    updated.append('KAFKA_API_KEY = "<your-api-key>"\n')
                elif line.startswith("KAFKA_API_SECRET ="):
                    updated.append('KAFKA_API_SECRET = "<your-api-secret>"\n')
                else:
                    updated.append(line)
            cell["source"] = updated
            break

out = Path("/mnt/data/Kafka Streaming - GitHub Safe.ipynb")
out.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
print(f"[Download the updated GitHub-safe notebook](sandbox:{out})")
